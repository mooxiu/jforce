@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")

config.jforce_source_root = "@JFORCE_SOURCE_DIR@"
config.jforce_obj_root = "@JFORCE_BINARY_DIR@"
config.jforce_tools_dir = "@JFORCE_TOOLS_DIR@"

import lit.llvm

lit.llvm.initialize(lit_config, config)

# Load the main, machine-independent configuration.
lit_config.load_config(
    config,
    "@JFORCE_SOURCE_DIR@/test/lit.cfg.py",
)
