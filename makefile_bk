LLVM_BIN_PATH=/home/haruka/Documents/workspace/projects/llvm-project/build/bin
FLANG=$(LLVM_BIN_PATH)/flang-new
CLANG=$(LLVM_BIN_PATH)/clang++

compile_fortran:
	$(FLANG) -c host-code/host.f90 -o host.o
	rm host_mod.mod

compile_runtime:
	$(CLANG) -std=c++14 -c host-code/runtime.cpp -o runtime.o

compile: compile_fortran compile_runtime
	$(FLANG) host.o runtime.o -lstdc++ -o demo
	rm runtime.o host.o


	